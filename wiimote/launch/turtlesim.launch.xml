<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <arg name="emulate_tty" default="True" />

  <let name="wiimote_params" value="$(find-pkg-share wiimote)/config/wiimote_params.yaml" />
  <let name="teleop_params" value="$(find-pkg-share wiimote)/config/teleop_wiimote_params.yaml" />


  <lifecycle_node pkg="wiimote" exec="wiimote_node" name="wiimote"
    namespace="" output="screen" autostart="true">
    <param from="$(var wiimote_params)" />
  </lifecycle_node>
  
  <lifecycle_node pkg="wiimote" exec="teleop_wiimote_node" name="teleop_wiimote"
    namespace="" output="screen" autostart="true">
    <param from="$(var teleop_params)" />
    <remap from="/cmd_vel" to="turtle1/cmd_vel" />
  </lifecycle_node>

  <node pkg="turtlesim" exec="turtlesim_node" name="turtle1" />

</launch>